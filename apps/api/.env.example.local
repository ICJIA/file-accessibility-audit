NODE_ENV=development
PORT=5103

# Database
DB_PATH=./data/audit.db

# Temp files (a PDF's short-lived qpdf copy)
TMP_DIR=/tmp

# The upload size limit is NOT set here. It is ANALYSIS.MAX_FILE_SIZE_MB (25)
# and REMEDIATION.MAX_FILE_SIZE_MB (50) in audit.config.ts; no environment
# variable overrides either. (A MAX_FILE_SIZE_MB=15 line used to sit here and
# was read by nothing.)

# Optional: fleet-integration service token (rate-tier + URL-allowlist bypass).
# Not a user credential — the tool has no accounts or sign-in.
# API_PRIVILEGED_TOKEN=
