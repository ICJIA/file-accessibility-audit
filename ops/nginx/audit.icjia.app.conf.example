# =============================================================================
# audit.icjia.app — nginx reverse proxy.  REFERENCE COPY of the live config.
# =============================================================================
#
# This is a copy of what the server really runs, taken from `sudo nginx -T`
# and from the site's nginx editor in Laravel Forge on 2026-11-24. (Before
# that date this file was a reconstruction from what the code assumes.)
#
# Nothing reads this file. Editing it changes nothing on the server: the live
# file is edited in Forge. When the live file changes, update this copy.
#
# The live configuration is in three pieces:
#   1. /etc/nginx/nginx.conf                       — the whole server (shared
#      with the other sites on this droplet)
#   2. /etc/nginx/sites-enabled/audit.icjia.app    — Forge's wrapper: the
#      `server { listen 443 ssl; … }` block, the certificate, and redirects
#      for plain HTTP and for www
#   3. /etc/nginx/forge-conf/3073957/site.conf     — everything below the
#      line "SITE.CONF". This is the part edited in Forge.
#
# WHAT THE CODE ASSUMES
#
#   web app (Nuxt/Nitro)   127.0.0.1:5102   ecosystem.config.cjs (HOST, PORT)
#   API (Express)          127.0.0.1:5103   audit.config.ts DEPLOY.BIND_HOST / API_PORT
#   /api/ goes STRAIGHT to the API — not through the web app.
#   /status and /healthz are web-app routes; they are NOT under /api/.
#
# FACTS ABOUT THE WHOLE SERVER THAT MATTER HERE (piece 1)
#
#   - `access_log /var/log/nginx/access.log;` is set for the whole server.
#     This site turns it OFF for itself (see below), but the two redirect
#     blocks (plain HTTP → HTTPS, and www → the bare name) have no setting of
#     their own and so inherit the server-wide log. A request to
#     http://audit.icjia.app/… or https://www.audit.icjia.app/… is therefore
#     logged (address, time, path, status, browser) before it is redirected.
#     A request to https://audit.icjia.app/… is not.
#   - /etc/nginx/conf.d/cloudflare.conf trusts Cloudflare's address ranges
#     and takes the caller's address from X-Forwarded-For when a request
#     comes from one of them. DNS for this site points straight at the
#     droplet, not at Cloudflare.
#   - nginx buffers proxied traffic by default, writing anything large to a
#     temporary file of its own. This site turns that off in both directions:
#       * uploads — `proxy_request_buffering off` in `location /api/` (added
#         2026-11-24; before that, an upload over 16 KB was written to a
#         temporary file and deleted when the request ended);
#       * the repaired-file download — the API sends `X-Accel-Buffering: no`
#         (routes/remediate.ts), so the file is passed straight through.
#
# =============================================================================

# ---- piece 2: Forge's wrapper (abridged) ------------------------------------

# Plain HTTP → HTTPS.            (inherits the server-wide access log)
server {
    listen 80;
    listen [::]:80;
    server_tokens off;
    server_name .audit.icjia.app;
    return 301 https://$host$request_uri;
}

# www → the bare name.           (inherits the server-wide access log)
# server { listen 443 ssl; server_name www.audit.icjia.app; … return 301 $scheme://audit.icjia.app$request_uri; }

server {
    http2 on;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name audit.icjia.app;
    server_tokens off;
    root /home/forge/audit.icjia.app;

    # Certificates — Forge manages these (Let's Encrypt).
    ssl_certificate     /etc/nginx/ssl/domains/<id>/<id>/server.crt;
    ssl_certificate_key /etc/nginx/ssl/domains/<id>/<id>/server.key;

    # ---- piece 3: SITE.CONF — exactly as live, 2026-11-24 -------------------

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_dhparam /etc/nginx/dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # Both apps send this header too; their copies are hidden in the two
    # location blocks below so a response carries it once, and nginx's own
    # error pages still have it.
    add_header X-Content-Type-Options "nosniff" always;

    index index.html index.htm;
    charset utf-8;

    # include forge-conf/3073957/server/*;

    client_max_body_size 35m;

    # Proxy 1: API — MUST come before the / block
    location /api/ {
        proxy_pass http://127.0.0.1:5103;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # THE CALLER'S ADDRESS. The API runs with `trust proxy` set to 1
        # (apps/api/src/app.ts), so Express takes the LAST address in
        # X-Forwarded-For — the one THIS proxy appends — as the caller. Every
        # rate limit is per caller address (middleware/rateLimiter.ts).
        # Without this header every visitor shares ONE rate-limit bucket.
        # Because only the last entry is trusted, a caller cannot choose a
        # bucket by sending a forged header. If another proxy is ever put in
        # FRONT of nginx, `trust proxy` must be raised to match.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # MUST be at least DEPLOY.NGINX_CLIENT_MAX_BODY_SIZE_MB (60): the
        # largest accepted upload is a 50 MB PDF for remediation, plus the
        # multipart envelope. Sizing this to the 25 MB audit limit broke
        # remediation in production (2026-08-13). Pinned by deployLimits.test.ts.
        client_max_body_size 60M;

        # MUST be at least DEPLOY.NGINX_PROXY_READ_TIMEOUT_S (180): a long
        # document may take two minutes to audit. At nginx's default of 60s a
        # 246-page report came back as an nginx error page (2026-08-28).
        proxy_read_timeout 180s;

        # Pass uploads straight to the API: nginx writes no temporary file.
        # The data-retention policy says an upload is never written to disk;
        # this line is what makes that true of the web server as well.
        proxy_request_buffering off;

        # The API sends these too; keep only the copies added above.
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Content-Type-Options;
    }

    # Proxy 2: Frontend (catch-all) — pages, assets, /status, /healthz
    location / {
        proxy_pass http://127.0.0.1:5102;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # /status can take tens of seconds on the first request after a
        # restart (it starts a Java process).
        proxy_read_timeout 90s;

        # The web app sends this too; keep only the copy added above.
        proxy_hide_header X-Content-Type-Options;
    }

    # Forge's default `location = /favicon.ico` and `location = /robots.txt`
    # blocks are commented out on the server, and must stay out: they answer
    # from `root`, which holds neither file, so both would 404 — and a missing
    # robots.txt means no Disallow rule is honoured. rebuild.sh's smoke checks
    # test for exactly this.

    # NO ACCESS LOG for this site. nginx records nothing about a request to
    # https://audit.icjia.app. (rateLimiter.ts's observability lines exist
    # because of this.)
    access_log off;

    # The error log IS kept. When nginx itself reports an error — the API not
    # answering, an upload over the size limit — the line includes the
    # caller's address and the request line.
    error_log  /var/log/nginx/3073957-error.log error;

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
